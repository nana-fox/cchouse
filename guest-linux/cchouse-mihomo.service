[Unit]
Description=cchouse (<TAG>) mihomo TUN proxy
After=cchouse-nftables.service network-online.target
Requires=cchouse-nftables.service
Wants=network-online.target

[Service]
Type=simple
User=<MIHOMO_USER>
Group=<MIHOMO_USER>
StateDirectory=cchouse-mihomo
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ExecStart=/usr/local/bin/mihomo -d /var/lib/cchouse-mihomo -f /usr/local/<TAG>/config.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
