# cchouse 实例参数模板。复制到私有目录再填，不要把填好的文件放进仓库：
#   D=~/Library/Application\ Support/cchouse/<TAG>; mkdir -p "$D"; chmod 700 "$D"
#   cp instance.env.example "$D/instance.env"; chmod 600 "$D/instance.env"
#
# 格式（shell 和 Python 都会读，按这个写）：
# - KEY=VALUE 一行一个，注释单独成行，不要写在值后面
# - 含空格的路径用双引号，可以用 $HOME
# - 凭据用单引号，原样不展开；凭据本身不能含单引号

# ==== 实例 ====
# 小写短名：客机路径 /usr/local/<TAG>、服务名 net.<TAG>.*
TAG=ex01
# tart 虚拟机名，和配好网络、未登录任何账号的干净快照名
VM_NAME=claude-ex01
CLEAN_SNAPSHOT=claude-ex01-clean-20261114

# ==== 宿主机 ====
# tart 命令（可以是设好 TART_HOME 的包装脚本，见 host/tart-wrapper.sh）
TART_BIN="$HOME/.local/bin/tart"
# 启动前等这个目录出现（虚拟机放外置盘时用来等挂载）
VM_STORAGE="/Volumes/External-SSD/tart/home"
# 桥接的物理网卡（ifconfig 里连着家里局域网的那个）
# 网络模式：bridged（默认，沿用已有实例）或 nat（不需要局域网直连客机时）
NETWORK_MODE=bridged
BRIDGE_IF=en1
# 运行日志放本机盘：开机自启（launchd）运行的 bash 没有外置盘写权限（macOS 隐私保护），写外置盘会直接失败退出
RUN_LOG="$HOME/Library/Logs/cchouse-ex01-run.log"
# 私有目录：这个文件、SSH 密钥、共享文件夹清单都放这里
PRIVATE_DIR="$HOME/Library/Application Support/cchouse/ex01"
SHARED_DIRS_FILE="$HOME/Library/Application Support/cchouse/ex01/shared-dirs.txt"
SSH_KEY="$HOME/Library/Application Support/cchouse/ex01/id_ed25519"
SSH_KNOWN_HOSTS="$HOME/Library/Application Support/cchouse/ex01/known_hosts"

# ==== 客机网络 ====
# 桥接后客机的局域网 IP（建议在路由器里按网卡地址固定）
GUEST_IP=192.168.100.59
# 家里路由器；验收时确认客机访问不到它
ROUTER_IP=192.168.100.1
# 家里局域网段：TUN 绕开它、pf 放行从它来的 SSH
HOME_LAN_CIDR=192.168.100.0/24
# 与出口 IP 所在地一致
TIMEZONE=America/Los_Angeles
# 选定的固定出口 IP 和 Cloudflare trace 的 loc，验收脚本据此判断
EXPECTED_EGRESS_IP=
EXPECTED_EGRESS_LOC=US
# 出口 IP 的运营商编号（ipinfo 的 org 第一段，如 AS33659）；验收和检查页据此确认还是那家家宽/ISP，没被换成机房 IP
EXPECTED_EGRESS_ASN=

# ==== 固定出口：Webshare 静态 ISP（SOCKS5）====
WEBSHARE_HOST=''
WEBSHARE_PORT=''
WEBSHARE_USER=''
WEBSHARE_PASS=''

# ==== 主入口：自建前置（VLESS + REALITY 及经 Cloudflare 的 VLESS + WS，见 docs/front.md）====
# 每台环境在前置上单独加一个 UUID（两条自建入口共用）；SERVER_IP:PORT 与 FRONT_CF_SERVER_IP:443 会写进 pf 白名单
FRONT_SERVER_IP=''
FRONT_PORT=''
FRONT_UUID=''
FRONT_SNI=''
FRONT_PUBLIC_KEY=''
FRONT_SHORT_ID=''
FRONT_FINGERPRINT='chrome'
FRONT_CF_SERVER_IP=''
FRONT_CF_HOST=''
FRONT_CF_WS_PATH=''
# Stripe 出口：front 从选中的前置直出（优先 FRONT 直连 / FRONT-CF，再回退机场）；tmh-chain 所有成员均以 FrontVPS 为末端（Front, Front-CF, 经机场中转到 FrontVPS）。
# tmh-chain 要求 FrontVPS 的 REALITY 入站已验证允许空 SNI，公钥认证保持开启。
STRIPE_EXIT_MODE=front

# ==== 备用入口：机场 VLESS 节点（两条入口互备，共用一个 UUID）====
# 只是个名字，出现在代理节点名里
NODE_LABEL=SJC01
NODE_UUID=''
# 两个 SERVER_IP 会同时写进 pf 白名单
NODE_WS_SERVER_IP=''
NODE_WS_HOST=''
NODE_WS_PATH=''
NODE_REALITY_SERVER_IP=''
NODE_REALITY_SNI=''
NODE_REALITY_PUBLIC_KEY=''
NODE_REALITY_SHORT_ID=''
