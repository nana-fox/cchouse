# cchouse v2 (Debian 13 / VirtualBox 或 Tart) 实例参数模板
# 复制到私有目录再填，不要放进仓库：
#   Windows: %LOCALAPPDATA%\cchouse\<TAG>\instance.env
#   macOS:   ~/Library/Application Support/cchouse/<TAG>/instance.env
#
# 格式要求：
# - KEY=VALUE 一行一个，注释单独成行
# - 含空格的路径用双引号；凭据用单引号（凭据本身不能含单引号）

# ==== 平台与模式 ====
GUEST_OS=linux
# 出口模式：single（单节点）或 chain（前置 -> 固定 ISP，兼容 v1）
EXIT_MODE=single
# Stripe 分流：
# - single 模式可选 off（默认，跟主出口）或 node（启用下方可选 STRIPE_NODE_* 专用节点）
# - chain 模式可选 off / front / tmh-chain
STRIPE_EXIT_MODE=off

# ==== 实例标识 ====
TAG=win01
VM_NAME=claude-win01
# VirtualBox 默认 enp0s3，Tart 默认 enp0s1。
GUEST_IF=enp0s3
# 客机运行 mihomo 的专用系统用户（nftables 按 skuid 精确放行）
MIHOMO_USER=mihomo

# ==== 宿主机（按系统修改为实际私有目录）====
PRIVATE_DIR="$HOME/AppData/Local/cchouse/win01"
SSH_KEY="$HOME/AppData/Local/cchouse/win01/id_ed25519"
SSH_KNOWN_HOSTS="$HOME/AppData/Local/cchouse/win01/known_hosts"
# 写入客机 authorized_keys 的公钥单行内容（由用户或 Agent 生成后填入）
SSH_PUBKEY=''

# ==== 客机网络与环境 ====
# VirtualBox NAT 通过宿主回环转发；SSH_PORT 填实际转发端口。
# Tart 使用实际 NAT 网段与客机 IP，直连 SSH 时删除 SSH_PORT。
VMNET_CIDR=10.0.2.0/24
GUEST_IP=127.0.0.1
SSH_PORT=2222
ROUTER_IP=192.168.100.1
HOME_LAN_CIDR=192.168.100.0/24
TIMEZONE=America/Los_Angeles
GUEST_LOCALE=en_US.UTF-8
GUEST_KEYBOARD=us
# 留空则在首次开机时自动生成随机主机名（推荐，防批量撞脸）
GUEST_HOSTNAME=''
EXPECTED_EGRESS_IP=
EXPECTED_EGRESS_LOC=US
EXPECTED_EGRESS_ASN=

# ==== 单节点出口（EXIT_MODE=single 时必填）====
# 支持：socks5 / http / vless / trojan / ss / ssh（拒绝 hysteria2 / tuic 等 UDP 协议）
SINGLE_TYPE=socks5
# 节点服务器（可填 IP 或域名）
SINGLE_SERVER=''
# 若 SINGLE_SERVER 为域名，此处填在宿主机解析并钉死的 IPv4（也可用 render.py --resolve 自动填入）
SINGLE_SERVER_IP=''
SINGLE_PORT=''
# 按协议按需填写（未用到的留空）
SINGLE_USER=''
SINGLE_PASS=''
SINGLE_UUID=''
SINGLE_SNI=''
SINGLE_FINGERPRINT='chrome'
SINGLE_FLOW=''
SINGLE_NETWORK='tcp'
SINGLE_WS_PATH=''
SINGLE_WS_HOST=''
SINGLE_PUBLIC_KEY=''
SINGLE_SHORT_ID=''
SINGLE_CIPHER=''
# 仅 socks5/http 需要 TLS 时填 true；vless/trojan 强制 TLS 且禁止填 false
SINGLE_TLS=''
# 仅 ssh 节点建议填写服务器公钥（ssh-keyscan 输出中的 ssh-ed25519 AAAA...）
SINGLE_HOST_KEY=''

# ==== 可选：单节点模式下的 Stripe 专用节点（STRIPE_EXIT_MODE=node 时必填）====
# 当主单节点（如 Webshare 静态 ISP）屏蔽 *.stripe.com 导致 claude.ai 付款失败时启用；
# 仅 stripe.com / stripe.network / stripecdn.com 走此节点，其余流量仍锁死主出口，且 nftables 同步放行其 IP:端口。
# 协议与字段口径同 SINGLE_*（支持 socks5 / http / vless / trojan / ss / ssh，禁止 UDP 协议）：
# STRIPE_NODE_TYPE=vless
# STRIPE_NODE_SERVER=''
# STRIPE_NODE_SERVER_IP=''
# STRIPE_NODE_PORT=''
# STRIPE_NODE_USER=''
# STRIPE_NODE_PASS=''
# STRIPE_NODE_UUID=''
# STRIPE_NODE_SNI=''
# STRIPE_NODE_FINGERPRINT='chrome'
# STRIPE_NODE_FLOW=''
# STRIPE_NODE_NETWORK='tcp'
# STRIPE_NODE_WS_PATH=''
# STRIPE_NODE_WS_HOST=''
# STRIPE_NODE_PUBLIC_KEY=''
# STRIPE_NODE_SHORT_ID=''
# STRIPE_NODE_CIPHER=''
# STRIPE_NODE_TLS=''
# STRIPE_NODE_HOST_KEY=''

# ==== 链式出口（仅 EXIT_MODE=chain 时必填，与 instance.env.example 同口径）====
# WEBSHARE_HOST=''
# WEBSHARE_PORT=''
# WEBSHARE_USER=''
# WEBSHARE_PASS=''
# FRONT_SERVER_IP=''
# FRONT_PORT=''
# FRONT_UUID=''
# FRONT_SNI=''
# FRONT_PUBLIC_KEY=''
# FRONT_SHORT_ID=''
# FRONT_FINGERPRINT='chrome'
# FRONT_CF_SERVER_IP=''
# FRONT_CF_HOST=''
# FRONT_CF_WS_PATH=''
# NODE_LABEL=SJC01
# NODE_UUID=''
# NODE_WS_SERVER_IP=''
# NODE_WS_HOST=''
# NODE_WS_PATH=''
# NODE_REALITY_SERVER_IP=''
# NODE_REALITY_SNI=''
# NODE_REALITY_PUBLIC_KEY=''
# NODE_REALITY_SHORT_ID=''
