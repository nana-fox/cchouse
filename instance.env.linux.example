# cchouse v2 (Debian 13 / VMware) 实例参数模板
# 复制到私有目录再填，不要放进仓库：
#   Windows: %LOCALAPPDATA%\cchouse\<TAG>\instance.env
#   macOS:   ~/Library/Application Support/cchouse/<TAG>/instance.env
#
# 格式要求：
# - KEY=VALUE 一行一个，注释单独成行
# - 含空格的路径用双引号；凭据用单引号（凭据本身不能含单引号）

# ==== 平台与模式 ====
GUEST_OS=linux
# 出口模式：single（单节点）或 chain（前置 -> 固定 ISP，兼容 v1）
EXIT_MODE=single
# Stripe 分流：single 模式必须为 off；chain 模式可选 off / front / tmh-chain
STRIPE_EXIT_MODE=off

# ==== 实例标识 ====
TAG=win01
VM_NAME=claude-win01
# 客机物理网卡名（VMware Debian 13 常见为 ens33，导入后以实际为准）
GUEST_IF=ens33
# 客机运行 mihomo 的专用系统用户（nftables 按 skuid 精确放行）
MIHOMO_USER=mihomo

# ==== 宿主机（Windows / Intel Mac）====
PRIVATE_DIR="$HOME/.cchouse/win01"
VMX_PATH=""
SSH_KEY="$HOME/.cchouse/win01/id_ed25519"
SSH_KNOWN_HOSTS="$HOME/.cchouse/win01/known_hosts"
# 写入客机 authorized_keys 的公钥单行内容（由用户或 Agent 生成后填入）
SSH_PUBKEY=''

# ==== 客机网络与环境 ====
# VMware NAT 模式网段（vmnet8），用于放行宿主 SSH 入站；桥接模式可保持默认
VMNET_CIDR=192.168.180.0/24
GUEST_IP=192.168.180.128
ROUTER_IP=192.168.100.1
HOME_LAN_CIDR=192.168.100.0/24
TIMEZONE=America/Los_Angeles
GUEST_LOCALE=en_US.UTF-8
GUEST_KEYBOARD=us
# 留空则在首次开机时自动生成随机主机名（推荐，防批量撞脸）
GUEST_HOSTNAME=''
EXPECTED_EGRESS_IP=
EXPECTED_EGRESS_LOC=US
EXPECTED_EGRESS_ASN=

# ==== 单节点出口（EXIT_MODE=single 时必填）====
# 支持：socks5 / http / vless / trojan / ss / ssh（拒绝 hysteria2 / tuic 等 UDP 协议）
SINGLE_TYPE=socks5
# 节点服务器（可填 IP 或域名）
SINGLE_SERVER=''
# 若 SINGLE_SERVER 为域名，此处填在宿主机解析并钉死的 IPv4（也可用 render.py --resolve 自动填入）
SINGLE_SERVER_IP=''
SINGLE_PORT=''
# 按协议按需填写（未用到的留空）
SINGLE_USER=''
SINGLE_PASS=''
SINGLE_UUID=''
SINGLE_SNI=''
SINGLE_FINGERPRINT='chrome'
SINGLE_FLOW=''
SINGLE_NETWORK='tcp'
SINGLE_WS_PATH=''
SINGLE_WS_HOST=''
SINGLE_PUBLIC_KEY=''
SINGLE_SHORT_ID=''
SINGLE_CIPHER=''
# 仅 socks5/http 需要 TLS 时填 true；vless/trojan 强制 TLS 且禁止填 false
SINGLE_TLS=''
# 仅 ssh 节点建议填写服务器公钥（ssh-keyscan 输出中的 ssh-ed25519 AAAA...）
SINGLE_HOST_KEY=''

# ==== 链式出口（仅 EXIT_MODE=chain 时必填，与 instance.env.example 同口径）====
# WEBSHARE_HOST=''
# WEBSHARE_PORT=''
# WEBSHARE_USER=''
# WEBSHARE_PASS=''
# FRONT_SERVER_IP=''
# FRONT_PORT=''
# FRONT_UUID=''
# FRONT_SNI=''
# FRONT_PUBLIC_KEY=''
# FRONT_SHORT_ID=''
# FRONT_FINGERPRINT='chrome'
# FRONT_CF_SERVER_IP=''
# FRONT_CF_HOST=''
# FRONT_CF_WS_PATH=''
# NODE_LABEL=SJC01
# NODE_UUID=''
# NODE_WS_SERVER_IP=''
# NODE_WS_HOST=''
# NODE_WS_PATH=''
# NODE_REALITY_SERVER_IP=''
# NODE_REALITY_SNI=''
# NODE_REALITY_PUBLIC_KEY=''
# NODE_REALITY_SHORT_ID=''
