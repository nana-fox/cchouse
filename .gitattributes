# 强制所有脚本、配置与文档使用 LF，防止 Windows git autocrlf 破坏 Linux 客机文件
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.nft text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.plist text eol=lf
*.ps1 text eol=crlf
