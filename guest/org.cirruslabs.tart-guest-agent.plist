<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.cirruslabs.tart-guest-agent</string>
<key>ProgramArguments</key><array><string>/usr/local/bin/tart-guest-agent</string><string>--run-agent</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>LimitLoadToSessionType</key><string>Aqua</string>
<key>StandardOutPath</key><string>/tmp/tart-guest-agent.<TAG>.log</string>
<key>StandardErrorPath</key><string>/tmp/tart-guest-agent.<TAG>.log</string>
</dict></plist>
